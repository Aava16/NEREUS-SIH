# NEREUS API Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# NEVER commit real credentials to version control.

# Database Connection (PostgreSQL with PostGIS extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nereus_db

# Debug Mode (Keep false in production)
DEBUG=false

# Application Metadata
APP_NAME=NEREUS API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Storage Root Directory (Relative to workspace root or absolute path)
DATA_ROOT=data

# CORS Allowed Origins
# Supports JSON array format or comma-separated string format:
# e.g., ["https://nereus-frontend.vercel.app", "http://localhost:5173"]
# or: https://nereus-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
