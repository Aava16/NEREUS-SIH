# NEREUS API Configuration Template
# Copy this file to .env and configure for your local environment.
# NEVER commit real credentials to version control.

# Database Connection (PostgreSQL with PostGIS extension)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nereus

# Debug Mode
DEBUG=false

# Application Settings
APP_NAME="NEREUS API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
