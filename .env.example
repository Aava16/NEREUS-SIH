# NEREUS-SIH Environment Configuration Template
# Copy this file to .env or backend/.env and customize for your environment.
# NEVER commit real credentials or private keys to source control.

# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ==========================================
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nereus_db

# ==========================================
# 2. APPLICATION CORE SETTINGS
# ==========================================
APP_NAME=NEREUS Scientific Ocean Data Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# ==========================================
# 3. CORS CONFIGURATION (Frontend Origin URLs)
# ==========================================
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ==========================================
# 4. SCIENTIFIC DATA STORAGE CONFIGURATION
# ==========================================
# Path relative to repository root or absolute path for NetCDF-4/Zarr scientific assets
NEREUS_DATA_ROOT=data
NEREUS_PROCESSED_DATA_DIR=data/processed
NEREUS_SAMPLES_DATA_DIR=data/samples

# ==========================================
# 5. EXTERNAL DATA PROVIDERS (Optional / Reference)
# ==========================================
# Copernicus Marine Service credentials (only needed if downloading fresh raw subsets via API)
COPERNICUS_MARINE_SERVICE_USER=
COPERNICUS_MARINE_SERVICE_PASSWORD=
